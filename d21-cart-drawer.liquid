<style>
.d21-cd { position: fixed; inset: 0; z-index: 9999; pointer-events: none; visibility: hidden; }
.d21-cd.is-open { pointer-events: auto; visibility: visible; }
.d21-cd__backdrop { position: absolute; inset: 0; background: rgba(0,0,0,0.45); opacity: 0; transition: opacity 0.3s ease; }
.d21-cd.is-open .d21-cd__backdrop { opacity: 1; }
.d21-cd__panel { position: absolute; top: 0; right: 0; bottom: 0; width: 100%; max-width: 420px; background: #fff; display: flex; flex-direction: column; transform: translateX(100%); transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1); box-shadow: -10px 0 40px rgba(0,0,0,0.15); }
.d21-cd.is-open .d21-cd__panel { transform: translateX(0); }
.d21-cd__head { display: flex; align-items: center; justify-content: space-between; padding: 22px 24px; border-bottom: 1px solid #f0f0f0; flex-shrink: 0; }
.d21-cd__title { font-size: 20px; font-weight: 800; }
.d21-cd__close { width: 36px; height: 36px; border-radius: 50%; background: #f3f3f3; border: none; cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 18px; color: #555; transition: background 0.2s; }
.d21-cd__close:hover { background: #e8e8e8; }
.d21-cd__body { flex: 1; overflow-y: auto; padding: 24px; }
.d21-cd__empty-msg { text-align: center; color: #999; font-size: 14px; margin-bottom: 24px; }
.d21-cd__featured { background: #ecfdf5; border: 1px solid #d1fae5; border-radius: 14px; padding: 22px 20px; text-align: center; }
.d21-cd__badge { display: inline-block; background: {{ section.settings.accent_color }}; color: #fff; padding: 5px 14px; border-radius: 50px; font-size: 11px; font-weight: 700; letter-spacing: 0.5px; margin-bottom: 12px; }
.d21-cd__featured-name { font-size: 17px; font-weight: 800; margin-bottom: 8px; }
.d21-cd__featured-desc { font-size: 13px; color: #777; line-height: 1.6; margin-bottom: 14px; }
.d21-cd__featured-price { font-size: 24px; font-weight: 900; margin-bottom: 16px; }
.d21-cd__add-btn { display: block; width: 100%; padding: 14px; background: {{ section.settings.accent_color }}; color: #fff; border: none; border-radius: 50px; font-size: 14px; font-weight: 700; cursor: pointer; transition: opacity 0.2s, transform 0.2s; font-family: inherit; }
.d21-cd__add-btn:hover { opacity: 0.9; transform: translateY(-1px); }
.d21-cd__add-btn:disabled { opacity: 0.6; cursor: wait; }
.d21-cd__item { background: #fafafa; border-radius: 14px; padding: 16px; margin-bottom: 16px; }
.d21-cd__item-img { width: 100%; height: 110px; object-fit: contain; background: #fff; border-radius: 10px; margin-bottom: 14px; }
.d21-cd__item-name { text-align: center; font-size: 15px; font-weight: 800; margin-bottom: 8px; }
.d21-cd__item-desc { text-align: center; font-size: 12px; color: #888; line-height: 1.5; margin-bottom: 14px; padding: 0 10px; }
.d21-cd__features { background: #fff; border-radius: 10px; padding: 14px 16px; list-style: none; margin: 0 0 16px; }
.d21-cd__features li { display: flex; align-items: center; gap: 10px; font-size: 12px; color: #444; padding: 5px 0; }
.d21-cd__feat-icon { font-size: 14px; }
.d21-cd__price-line { display: flex; align-items: baseline; gap: 8px; margin-top: 8px; }
.d21-cd__price { font-size: 22px; font-weight: 900; }
.d21-cd__price-label { font-size: 11px; color: #999; }
.d21-cd__remove { display: inline-block; margin-top: 8px; background: none; border: none; color: #999; font-size: 12px; cursor: pointer; padding: 0; text-decoration: underline; font-family: inherit; }
.d21-cd__remove:hover { color: #555; }
.d21-cd__foot { border-top: 1px solid #f0f0f0; padding: 18px 24px 22px; flex-shrink: 0; }
.d21-cd__guarantee { background: #ecfdf5; padding: 11px 14px; border-radius: 10px; font-size: 12px; color: #065f46; text-align: center; margin-bottom: 12px; display: flex; align-items: center; justify-content: center; gap: 8px; }
.d21-cd__timer { display: flex; align-items: center; gap: 8px; font-size: 12px; color: #666; margin-bottom: 12px; }
.d21-cd__timer-dot { width: 7px; height: 7px; border-radius: 50%; background: #ff5252; animation: d21-pulse-scale 1.4s infinite; }
.d21-cd__timer-val { color: #ff5252; font-weight: 700; }
.d21-cd__total-row { display: flex; justify-content: space-between; align-items: center; padding: 12px 0; border-top: 1px solid #f0f0f0; font-size: 16px; font-weight: 700; }
.d21-cd__total-row strong { font-size: 22px; font-weight: 900; }
.d21-cd__form { margin: 0; }
.d21-cd__checkout { display: block; width: 100%; padding: 16px; background: {{ section.settings.cta_color }}; color: #fff; border: none; border-radius: 50px; font-size: 15px; font-weight: 700; text-align: center; text-decoration: none; cursor: pointer; transition: opacity 0.2s, transform 0.2s; font-family: inherit; margin-bottom: 14px; }
.d21-cd__checkout:hover { opacity: 0.92; transform: translateY(-1px); }
.d21-cd__pay { display: flex; justify-content: center; gap: 8px; margin-bottom: 8px; }
.d21-cd__pay-icon { background: #f3f3f3; padding: 4px 10px; border-radius: 5px; font-size: 9px; font-weight: 800; color: #555; min-width: 36px; text-align: center; }
.d21-cd__ssl { text-align: center; font-size: 11px; color: #999; }
.d21-cart-trigger { cursor: pointer; }
</style>

<aside class="d21-cd" id="d21-cart-drawer" aria-hidden="true">
  <div class="d21-cd__backdrop" data-cart-close></div>
  <div class="d21-cd__panel">
    <header class="d21-cd__head">
      <h2 class="d21-cd__title">{{ section.settings.drawer_title | default: 'Ton panier' }}</h2>
      <button class="d21-cd__close" data-cart-close aria-label="Fermer">✕</button>
    </header>

    <div class="d21-cd__body" id="d21-cart-body">
      <p class="d21-cd__empty-msg" id="d21-cart-empty-msg">{{ section.settings.empty_text | default: 'Ton panier est vide' }}</p>

      {% if section.settings.show_featured %}
        <div class="d21-cd__featured" id="d21-cart-featured">
          <div class="d21-cd__badge">{{ section.settings.featured_badge | default: 'LE + CHOISIS' }}</div>
          <div class="d21-cd__featured-name">{{ section.settings.featured_name | default: 'PACK ULTIME' }}</div>
          <div class="d21-cd__featured-desc">{{ section.settings.featured_desc | default: 'Le combo complet : fournisseur authentique 1.1 + méthode 0 à 10k/mois. Tout pour démarrer et scaler.' }}</div>
          <div class="d21-cd__featured-price">{{ section.settings.featured_price | default: '21,99 €' }}</div>
          <button class="d21-cd__add-btn" id="d21-cart-add-featured" data-variant-id="{{ section.settings.featured_variant_id }}">{{ section.settings.add_text | default: 'Ajouter au panier' }}</button>
        </div>
      {% endif %}

      <div id="d21-cart-items"></div>
    </div>

    <footer class="d21-cd__foot" id="d21-cart-foot" style="display:none">
      <div class="d21-cd__guarantee"><span>🛡️</span> {{ section.settings.guarantee_text | default: 'Satisfait ou remboursé sous 14 jours' }}</div>
      {% if section.settings.show_timer %}
        <div class="d21-cd__timer">
          <span class="d21-cd__timer-dot"></span>
          <span>{{ section.settings.timer_text | default: 'Réservé encore' }}</span>
          <span class="d21-cd__timer-val" id="d21-cart-timer">15:00</span>
        </div>
      {% endif %}
      <div class="d21-cd__total-row">
        <span>{{ section.settings.total_label | default: 'Total' }}</span>
        <strong id="d21-cart-total">0,00 €</strong>
      </div>
      <form action="/cart" method="post" novalidate class="d21-cd__form" id="d21-cart-form">
        <button type="submit" name="checkout" class="d21-cd__checkout" id="d21-cart-checkout">{{ section.settings.checkout_text | default: 'Finaliser ma commande' }}</button>
      </form>
      <div class="d21-cd__pay">
        <span class="d21-cd__pay-icon">VISA</span>
        <span class="d21-cd__pay-icon">MC</span>
        <span class="d21-cd__pay-icon">Pay</span>
        <span class="d21-cd__pay-icon">GPay</span>
        <span class="d21-cd__pay-icon">PP</span>
      </div>
      <div class="d21-cd__ssl">🔒 {{ section.settings.ssl_text | default: 'Paiement sécurisé SSL' }}</div>
    </footer>
  </div>
</aside>

<script>
(function() {
  var drawer = document.getElementById('d21-cart-drawer');
  if (!drawer) return;
  var emptyMsg = document.getElementById('d21-cart-empty-msg');
  var featured = document.getElementById('d21-cart-featured');
  var itemsEl = document.getElementById('d21-cart-items');
  var foot = document.getElementById('d21-cart-foot');
  var totalEl = document.getElementById('d21-cart-total');
  var addBtn = document.getElementById('d21-cart-add-featured');

  function fmtPrice(cents) { return (cents / 100).toFixed(2).replace('.', ',') + ' €'; }

  function openCart() {
    drawer.classList.add('is-open');
    drawer.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    fetchCart();
  }
  function closeCart() {
    drawer.classList.remove('is-open');
    drawer.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }
  window.d21OpenCart = openCart;
  window.d21CloseCart = closeCart;

  drawer.querySelectorAll('[data-cart-close]').forEach(function(el) { el.addEventListener('click', closeCart); });
  document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeCart(); });

  function fetchCart() { fetch('/cart.js').then(function(r) { return r.json(); }).then(renderCart); }

  function renderCart(cart) {
    if (!cart || cart.item_count === 0) {
      if (emptyMsg) emptyMsg.style.display = 'block';
      if (featured) featured.style.display = 'block';
      if (itemsEl) itemsEl.innerHTML = '';
      if (foot) foot.style.display = 'none';
      return;
    }
    if (emptyMsg) emptyMsg.style.display = 'none';
    if (featured) featured.style.display = 'none';
    if (foot) foot.style.display = 'block';
    if (totalEl) totalEl.textContent = fmtPrice(cart.total_price);

    var feats = {{ section.settings.item_features | default: 'Accès fournisseur exclusif|Marges et pricing détaillés|2 stratégies bonus testées|Plan de lancement complet' | json }};
    var featIcons = ['📁','💰','🚀','📝','✨','🎯'];
    var featList = feats.split('|').map(function(f, i) {
      return '<li><span class="d21-cd__feat-icon">' + (featIcons[i] || '•') + '</span>' + f.trim() + '</li>';
    }).join('');

    if (itemsEl) {
      itemsEl.innerHTML = cart.items.map(function(item) {
        return '<div class="d21-cd__item">' +
          (item.image ? '<img class="d21-cd__item-img" src="' + item.image + '" alt="">' : '') +
          '<div class="d21-cd__item-name">' + item.product_title + '</div>' +
          '<div class="d21-cd__item-desc">{{ section.settings.item_desc | default: "Guide complet avec accès fournisseur, stratégies testées et méthodes bonus." }}</div>' +
          '<ul class="d21-cd__features">' + featList + '</ul>' +
          '<div class="d21-cd__price-line">' +
            '<span class="d21-cd__price">' + fmtPrice(item.line_price) + '</span>' +
            '<span class="d21-cd__price-label">{{ section.settings.price_label | default: "Paiement unique" }}</span>' +
          '</div>' +
          '<button class="d21-cd__remove" onclick="d21RemoveItem(\'' + item.key + '\')">{{ section.settings.remove_text | default: "Retirer du panier" }}</button>' +
        '</div>';
      }).join('');
    }
  }

  window.d21AddToCart = function(variantId, qty) {
    if (!variantId) { alert('Aucun produit configuré'); return Promise.resolve(); }
    return fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: variantId, quantity: qty || 1 })
    }).then(function(r) { return r.json(); }).then(function() { openCart(); });
  };

  window.d21RemoveItem = function(key) {
    fetch('/cart/change.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: key, quantity: 0 })
    }).then(function(r) { return r.json(); }).then(renderCart);
  };

  if (addBtn) {
    addBtn.addEventListener('click', function() {
      var vid = addBtn.getAttribute('data-variant-id');
      if (!vid) { alert('Configure le produit dans l\'éditeur'); return; }
      addBtn.disabled = true;
      window.d21AddToCart(vid).finally(function() { addBtn.disabled = false; });
    });
  }

  document.addEventListener('click', function(e) {
    var trigger = e.target.closest('[data-cart-open], .d21-cart-trigger');
    if (trigger) { e.preventDefault(); openCart(); }
  });

  {% if section.settings.show_timer %}
  var timerEl = document.getElementById('d21-cart-timer');
  if (timerEl) {
    var endTime = parseInt(sessionStorage.getItem('d21_timer_end') || '0');
    var now = Date.now();
    if (!endTime || endTime < now) {
      endTime = now + ({{ section.settings.timer_minutes | default: 15 }} * 60 * 1000);
      sessionStorage.setItem('d21_timer_end', endTime);
    }
    function tick() {
      var diff = Math.max(0, endTime - Date.now());
      var m = Math.floor(diff / 60000);
      var s = Math.floor((diff % 60000) / 1000);
      timerEl.textContent = (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s;
    }
    tick(); setInterval(tick, 1000);
  }
  {% endif %}
})();
</script>

{% schema %}
{
  "name": "Panier Drawer",
  "settings": [
    { "type": "header", "content": "Couleurs" },
    { "type": "color", "id": "accent_color", "label": "Couleur accent", "default": "#10B981" },
    { "type": "color", "id": "cta_color", "label": "Couleur bouton checkout", "default": "#10B981" },
    { "type": "header", "content": "Textes" },
    { "type": "text", "id": "drawer_title", "label": "Titre du panier", "default": "Ton panier" },
    { "type": "text", "id": "empty_text", "label": "Texte panier vide", "default": "Ton panier est vide" },
    { "type": "text", "id": "add_text", "label": "Bouton ajouter", "default": "Ajouter au panier" },
    { "type": "text", "id": "remove_text", "label": "Bouton retirer", "default": "Retirer du panier" },
    { "type": "text", "id": "checkout_text", "label": "Bouton checkout", "default": "Finaliser ma commande" },
    { "type": "text", "id": "total_label", "label": "Label total", "default": "Total" },
    { "type": "text", "id": "price_label", "label": "Label prix", "default": "Paiement unique" },
    { "type": "header", "content": "Produit suggéré (panier vide)" },
    { "type": "checkbox", "id": "show_featured", "label": "Afficher la suggestion produit dans le panier vide", "default": true },
    { "type": "text", "id": "featured_variant_id", "label": "ID Variant produit", "default": "58205509583196", "info": "L'utilisateur doit cliquer sur 'Ajouter au panier' pour ajouter le produit." },
    { "type": "text", "id": "featured_badge", "label": "Badge", "default": "LE + CHOISIS" },
    { "type": "text", "id": "featured_name", "label": "Nom", "default": "PACK ULTIME" },
    { "type": "textarea", "id": "featured_desc", "label": "Description", "default": "Le combo complet : fournisseur authentique 1.1 + méthode 0 à 10k/mois. Tout pour démarrer et scaler." },
    { "type": "text", "id": "featured_price", "label": "Prix affiché", "default": "21,99 €" },
    { "type": "header", "content": "Détails item" },
    { "type": "textarea", "id": "item_desc", "label": "Description", "default": "Guide complet avec accès fournisseur, stratégies testées et méthodes bonus." },
    { "type": "textarea", "id": "item_features", "label": "Features (séparées par |)", "default": "Accès fournisseur exclusif|Marges et pricing détaillés|2 stratégies bonus testées|Plan de lancement complet" },
    { "type": "header", "content": "Garantie & Timer" },
    { "type": "text", "id": "guarantee_text", "label": "Texte garantie", "default": "Satisfait ou remboursé sous 14 jours" },
    { "type": "checkbox", "id": "show_timer", "label": "Afficher le timer", "default": true },
    { "type": "text", "id": "timer_text", "label": "Texte avant timer", "default": "Réservé encore" },
    { "type": "range", "id": "timer_minutes", "label": "Durée timer (min)", "min": 5, "max": 60, "step": 1, "default": 15 },
    { "type": "text", "id": "ssl_text", "label": "Texte SSL", "default": "Paiement sécurisé SSL" }
  ]
}
{% endschema %}
